[mysqld]
# 编码
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---------- 以下为 Debezium CDC 所需配置 ----------

# 复制架构中节点的唯一标识，同一复制拓扑内不能冲突
server-id = 1

# 开启二进制日志，记录所有数据变更，CDC 的数据来源
log_bin = mysql-bin

# 行级日志格式，Debezium 只支持 ROW，STATEMENT/MIXED 无法解析出行变更
binlog_format = ROW

# 行镜像完整度：
#   FULL    记录变更前后的所有列（Debezium 推荐，前镜像供 undo 场景使用）
#   MINIMAL 只记录变更的列和主键，日志小但 Debezium 拿不到完整前镜像
#   NOBLOB  同 FULL，但不记录未变更的 BLOB/TEXT 列
binlog_row_image = FULL

# 行元数据完整度（MySQL 8.0 新增）：
# FULL 时 binlog 事件携带列的 signed、charset、enum/set 值等元信息，
# Debezium 可直接从 binlog 还原列结构；MINIMAL 时需额外回表查询 schema。
# 默认 MINIMAL，建议与 binlog_row_image 一起设为 FULL
binlog_row_metadata = FULL

# binlog 保留时长，避免日志无限增长占满磁盘。
# expire_logs_days 已在 8.0 中废弃，改用秒级参数，864000 秒 = 10 天。
# 保留时长需覆盖 Debezium 最长可能的停机时间，否则 offset 对应的日志被清理后只能重新 snapshot
binlog_expire_logs_seconds = 864000

# 开启 GTID，为每个事务分配全局唯一 ID。
# 便于 Debezium 在主从切换后定位变更位点（对应 connector 的 gtidsource 策略）
gtid_mode = ON
enforce_gtid_consistency = ON
